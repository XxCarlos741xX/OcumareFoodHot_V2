# ============================================================
#  Ocumare Food - variables del servidor
#  Copia este archivo a /etc/ocumare/ocumare.env y llena los valores.
#  NO lo subas a GitHub ni lo compartas: tiene las contraseñas.
# ============================================================

SPRING_PROFILES_ACTIVE=prod

# --- Base de datos (Aiven > tu servicio MySQL > Overview > Connection information) ---
# Formato: jdbc:mysql://HOST:PUERTO/defaultdb?sslMode=REQUIRED
DB_URL=jdbc:mysql://mysql-ocumare-xxxx.aivencloud.com:12345/defaultdb?sslMode=REQUIRED
DB_USER=avnadmin
DB_PASSWORD=pega-aqui-la-contraseña-de-aiven

# --- Firma de las sesiones del POS ---
# Genérala en el servidor con:  openssl rand -base64 48
JWT_SECRET=pega-aqui-el-resultado-de-openssl

# --- Usuario administrador inicial (solo se crea si no existe) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pon-una-contraseña-larga-y-unica

# --- Aviso de pedidos web por Telegram (opcional; vacío = desactivado) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tasa oficial del BCV automática (cada hora). Pon false para manejarla solo a mano ---
TASA_BCV_ACTIVA=true

# --- Base de datos para los respaldos (respaldo.sh) ---
# Mismos datos de Aiven, separados:
DB_HOST=mysql-ocumare-xxxx.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
